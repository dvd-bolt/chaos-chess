# Скопируй в server/.env и заполни. Без значений игра работает как обычный сайт.
PORT=8099
# Токен админки /admin.html (любая длинная случайная строка)
ADMIN_TOKEN=
# Токен игрового бота от @BotFather: проверка initData, /start, Stars, посты в канал
BOT_TOKEN=
# Ссылка Mini App вида https://t.me/<бот>/<app> — приглашения открываются сразу в Telegram
TG_APP_LINK=
# ID рекламного блока Adsgram (Reward) — реклама за подсказку
ADSGRAM_BLOCK_ID=
# Необязательно: токен приёма задач напоминалки (сбои и /paysupport)
REMIND_TOKEN=
# Прочее (есть значения по умолчанию)
HOST=127.0.0.1
PUBLIC_URL=
DB_PATH=
REMIND_URL=
